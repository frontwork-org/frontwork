{
  // JSR package: https://jsr.io/@frontwork-org/frontwork
  "name": "@frontwork-org/frontwork",
  "version": "0.4.12",
  "license": "MIT",
  "exports": {
    ".": "./lib.ts",
    "./bundler": "./frontwork-bundler.ts",
    "./service": "./frontwork-service.ts",
    "./testworker": "./frontwork-testworker.ts"
  },
  "publish": {
    "exclude": ["node_modules", "dist", "test"]
  },

  "compilerOptions": {
    "lib": ["ES2015", "dom", "deno.window"],
    "strict": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [], // "no-floating-promises" is not jet implemented in Typescript & Deno. It only exists in ESlint. It will make our lives easier then it is implemented
      "exclude": ["no-unused-vars", "require-await"]
    }
  },
  "fmt": {
    "useTabs": true,
    "lineWidth": 80,
    "indentWidth": 4,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
}
